<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AssemblyName>HoyoTray</AssemblyName>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\resin.ico</ApplicationIcon>
    <RootNamespace>HoyoTray</RootNamespace>
    <!-- WebView2 package drags in a harmless WPF reference conflict; also skip its XML docs -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\resin.png" LogicalName="resin.png" />
    <EmbeddedResource Include="Assets\trailblaze.png" LogicalName="trailblaze.png" />
    <EmbeddedResource Include="Assets\battery.png" LogicalName="battery.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
